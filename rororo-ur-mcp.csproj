<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- AssemblyName = plugin id, family convention (ur-task does the same): with no better
         information the host resolves a plugin's exe as <id>.exe, and the manifest's entrypoint
         should agree with what the build actually produces. -->
    <AssemblyName>626labs.ur-mcp</AssemblyName>
    <RootNamespace>Labs626.UrMcp</RootNamespace>
    <Version>0.1.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Official C# MCP SDK, pinned per the plan's pin-at-implement-time instruction. -->
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
    <PackageReference Include="Grpc.Net.Client" Version="2.70.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Published via the host repo's trusted-publishing workflow; 0.9.0 is the first version
         carrying GetAccounts. -->
    <PackageReference Include="ROROROblox.PluginContract" Version="0.9.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="rororo-ur-mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
